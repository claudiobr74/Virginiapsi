NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPABASE_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Assina o session_capture_grant e o audio_fallback_upload_grant (Fase 6).
# Nunca reutilize outro segredo aqui — troca de chave deve poder acontecer
# sem afetar o token do Google.
SESSION_CAPTURE_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Um dos dois (From WhatsApp ou Messaging Service) é exigido no envio.
TWILIO_WHATSAPP_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Transcrição ao vivo. Sem GROQ_API_KEY o transcribe-chunk responde 503.
GROQ_API_KEY=
# Opcional. Default whisper-large-v3-turbo
GROQ_TRANSCRIPTION_MODEL=
# Opcional. Timeout em ms (5000–120000)
GROQ_TRANSCRIPTION_TIMEOUT_MS=
GEMINI_API_KEY=
GEMINI_MODEL_SESSION=
GEMINI_MODEL_SUPERVISOR=
GEMINI_MODEL_KNOWLEDGE=
# Opcional. Default: gemini-3.6-flash (módulo Documentos).
GEMINI_MODEL_DOCUMENTS=
GEMINI_EMBEDDING_MODEL=
CRON_SECRET=

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# Generated at install-time by scripts/copy-onnx-wasm.mjs (Fase 6: local
# transcription) — never commit ONNX Runtime Web's binaries to git.
/public/ort/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase local
supabase/.temp/
supabase/.branches/

# cursor / OS
.cursor/debug.log

# spikes: código e resultados entram no repo; dependências e áudio baixado, não
spikes/**/node_modules/
spikes/**/corpus/
